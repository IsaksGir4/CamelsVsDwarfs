    {
      "name": "Ejemplos de errores (400/401/403/404/409)",
      "item": [
        {
          "name": "400 - Body invalido (campos faltantes)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/players",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "players"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Body sin los campos obligatorios -> 400 Bad Request con detalle de validacion por campo."
          }
        },
        {
          "name": "401 - Sin token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/players",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "players"
              ]
            },
            "description": "Sin header Authorization -> 401 Unauthorized (respuesta JSON estructurada)."
          }
        },
        {
          "name": "403 - Rol insuficiente (viewer crea carrera)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_viewer}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/races",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "races"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"raceName\": \"Carrera de prueba\",\n  \"description\": \"Carrera de ejemplo para pruebas\",\n  \"programationDate\": \"2026-12-01\",\n  \"programationHour\": \"09:00:00\",\n  \"ubicationStart\": \"Alto de las Palmas\",\n  \"ubicationFinish\": \"Envigado\",\n  \"distanceMeters\": 1000,\n  \"maxPlayers\": 4,\n  \"raceType\": \"INDIVIDUAL\",\n  \"registrationDeadline\": \"2026-11-25\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Ejecutar primero 'Obtener token - viewer' en la carpeta Auth. Un VIEWER no puede crear carreras -> 403 Forbidden."
          }
        },
        {
          "name": "404 - Recurso inexistente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/players/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "players",
                "00000000-0000-0000-0000-000000000000"
              ]
            },
            "description": "UUID valido pero que no existe -> 404 Not Found."
          }
        },
        {
          "name": "409 - Conflicto (nickname duplicado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/players",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "players"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Byte Amel\",\n  \"nickname\": \"ByteTheCamel\",\n  \"playerType\": \"CAMEL\",\n  \"birthDate\": \"2018-05-10\",\n  \"height\": 2.1,\n  \"weight\": 450.0,\n  \"placeOfBirth\": \"Alto de las Palmas\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Ejecutar dos veces seguidas con el mismo nickname -> la segunda vez responde 409 Conflict (nickname ya existe)."
          }
        }
      ]
