  "item": [
    {
      "name": "Auth (Keycloak)",
      "item": [
        {
          "name": "Obtener token - admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{keycloak_url}}/realms/camelsvsdwarfs/protocol/openid-connect/token",
              "host": [
                "{{keycloak_url}}"
              ],
              "path": [
                "realms",
                "camelsvsdwarfs",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "camelsvsdwarfs-swagger"
                },
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "admin"
                },
                {
                  "key": "password",
                  "value": "admin123"
                }
              ]
            },
            "description": "Obtiene un token para el usuario admin. El script de Tests guarda automaticamente el token en la variable de coleccion {{token}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
