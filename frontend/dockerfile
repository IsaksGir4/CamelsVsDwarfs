# syntax=docker/dockerfile:1

# --- Etapa de build -------------------------------------------------------
FROM node:22-alpine AS builder
WORKDIR /app

# Las variables VITE_* se resuelven en tiempo de build: Vite las incrusta en el
# bundle, por eso llegan como ARG y no como variables de entorno del contenedor.
ARG VITE_API_BASE_URL=http://localhost:8080/api
ARG VITE_KEYCLOAK_URL=http://localhost:8180
ARG VITE_KEYCLOAK_REALM=camelsvsdwarfs
ARG VITE_KEYCLOAK_CLIENT_ID=camelsvsdwarfs-frontend

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL \
    VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM \
    VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# --- Etapa de ejecucion ---------------------------------------------------
FROM nginx:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=10s \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]